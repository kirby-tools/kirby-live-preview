{
  "name": "kirby-live-preview",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "PLAYGROUND=true kirbyup dev src/panel/index.ts",
    "build": "kirbyup src/panel/index.ts",
    "build:assets": "rm -rf assets && esbuild src/assets/iframe/index.ts --bundle --minify --format=esm --target=es2020 --outfile=assets/iframe.js",
    "build:playground": "PLAYGROUND=true pnpm run build && pnpm run build:assets",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" \"tests/panel/**\" --write",
    "test": "vitest",
    "test:types": "vue-tsc --noEmit",
    "release": "pnpm run build && pnpm run build:assets && bumpp --all --execute \"node scripts/pre-release.mjs\" && composer update"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@kirby-tools/licensing": "^1.1.0",
    "@types/node": "^26.6.11",
    "@unocss/eslint-plugin": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "bumpp": "^12.3.0",
    "es-toolkit": "^1.53.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "kirby-types": "^2.0.0",
    "kirbyup": "^4.0.0",
    "kirbyuse": "^2.0.0",
    "prettier": "^3.10.1",
    "tinyexec": "^1.4.0",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "unocss": "^66.13.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
